{
  "name": "badi-calendar",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "description": "Badíʿ Calendar browser extension",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build -b chrome && wxt build -b edge && wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "compile-less": "node scripts/compile-less.mjs"
  },
  "devDependencies": {
    "dayjs": "1.11.23",
    "less": "4.9.1",
    "wxt": "0.21.5"
